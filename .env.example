# Local development settings.
#   1. Copy this file:  cp .env.example .env
#   2. .env is git-ignored. Never commit it.
# These are throwaway values for databases running on your own machine.
# Never put real passwords, API keys or tokens in this file.
# Docker Compose reads .env automatically, and the app imports it (see application.yml).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthpay
DB_USERNAME=healthpay
DB_PASSWORD=healthpay_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SERVER_PORT=8080
